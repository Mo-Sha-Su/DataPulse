# ---------- Required ----------
# Any PostgreSQL 14+. For Neon, paste the connection string from the Neon console (Connect -> pooled/"-pooler" host is fine;
# pooled and direct endpoints are both supported). Keep the real value in backend/.env, which is git-ignored - never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Signs login tokens. Required in production, min 32 chars. Generate: openssl rand -hex 48
# Changing it logs everyone out.
JWT_SECRET=replace-with-a-random-64-char-hex-string-min-32-chars

# ---------- Optional ----------
NODE_ENV=development            # set to "production" when deployed
PORT=3000                       # API port (root server.ts mounts Express + Vite/dist on port 3000)
JWT_EXPIRES_IN=7d
MAX_BODY_MB=25                  # largest accepted JSON body (dataset uploads travel as JSON)
TRUST_PROXY=1                   # number of reverse proxies in front (Render/Cloud Run/Nginx = 1)
ALLOWED_ORIGINS=                # comma separated; only needed if the frontend is served from a different origin
CSP_MODE=enforce                # enforce | report-only | off
AUTO_MIGRATE=true               # apply DB migrations on startup
LOG_LEVEL=info                  # debug | info | warn | error | silent
DATABASE_POOL_MAX=10
STATIC_DIR=                     # optional: path to a built frontend (frontend/dist) for standalone backend hosting

# ---------- Python Forecasting Engine ----------
FORECAST_PYTHON_BIN=            # optional override path to Python 3.11+ binary (defaults to backend/forecasting_engine/.venv/bin/python3)
FORECAST_MAX_OBSERVATIONS=10000 # maximum aggregated observations accepted by the forecasting engine
FORECAST_MAX_CONCURRENT=3       # max simultaneous Python forecast subprocesses
FORECAST_TIMEOUT_MS=45000       # per-run execution timeout in milliseconds
